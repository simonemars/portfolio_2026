{
  "expo": {
    "name": "Phega",
    "slug": "phega",
    "scheme": "phega",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0e2337"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0e2337"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Phega to access your photos so you can set a profile picture."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://phega.onrender.com",
      "eas": {
        "projectId": "REPLACE-WITH-EAS-PROJECT-ID"
      }
    }
  }
}
